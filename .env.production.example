# Production environment for contrastco.tech.
# Copy to .env.production on the VPS (never commit the real file):
#   cp .env.production.example .env.production
#
# NEXT_PUBLIC_* values are compiled into the build, so changing any of them
# requires `npm run build` again (deploy-frontend.sh does this).

# Backend API, including the /api/v1 prefix.
NEXT_PUBLIC_API_BASE_URL=https://api.contrastco.tech/api/v1

# Must be "false" in production, otherwise the shop shows sample data.
NEXT_PUBLIC_DEMO_MODE=false

# Public origin of this site (sitemap.xml, robots.txt, Open Graph URLs).
NEXT_PUBLIC_SITE_URL=https://contrastco.tech

# Product opened by "Design your case" in the nav (optional; this is the default).
NEXT_PUBLIC_CUSTOM_CASE_PRODUCT_SLUG=custom-case
