# Base URL of the phone-cases-backend public API, INCLUDING the /api/v1 prefix.
# Example for a backend running on another machine on the local network:
#   NEXT_PUBLIC_API_BASE_URL=http://192.168.1.7:3010/api/v1
# Example for a backend running on this machine:
#   NEXT_PUBLIC_API_BASE_URL=http://localhost:3010/api/v1
NEXT_PUBLIC_API_BASE_URL=http://localhost:3010/api/v1

# Demo mode renders the storefront with clearly-labeled local fixture data
# instead of calling the backend. This is required until a real backend is
# reachable at NEXT_PUBLIC_API_BASE_URL. Set to "false" to use live data.
# There is no automatic/silent fallback: if demo mode is "false" and the API
# request fails, the UI shows an explicit error instead of fake data.
NEXT_PUBLIC_DEMO_MODE=true

# The public origin this site is deployed at. Used for sitemap.xml,
# robots.txt, and absolute Open Graph URLs. Defaults to localhost for
# local dev — set to the real domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
